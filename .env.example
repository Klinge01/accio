GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Best-match cosine below which a question counts as "not in notes" (0..1).
ACCIO_MIN_SIMILARITY=0.30
# Image captions with a local vision model: 1 = on (~11-27 s/image), 0 = OCR only.
ACCIO_CAPTION=0
# Also search each question translated between German and English: 1 = on, 0 = off.
ACCIO_TRANSLATE=1
# Editor for code citations (zed, idea, cursor, code).
ACCIO_CODE_EDITOR=zed
# ACCIO_HOME defaults to ~/Library/Application Support/accio/
# ACCIO_INGEST_CMD defaults to uv run --project <repo>/ingest accio-ingest serve
# ACCIO_EMBED_CMD defaults to uv run --project <repo>/ingest accio-ingest embed-server
